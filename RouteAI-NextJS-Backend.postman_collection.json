    {
      "name": "Login - Success (200)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "Run after Register - Success. Saves access_token/refresh_token into the environment for later requests.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Returns access and refresh tokens', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data.access_token).to.be.a('string');",
              "  pm.expect(json.data.refresh_token).to.be.a('string');",
              "  pm.environment.set('access_token', json.data.access_token);",
              "  pm.environment.set('refresh_token', json.data.refresh_token);",
              "  pm.environment.set('user_id', json.data.user.id);",
              "});"
            ]
          }
        }
      ]
    },
