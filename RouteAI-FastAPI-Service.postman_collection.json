    {
      "name": "OCR Preprocess - Corrupted Image (422)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/ocr/preprocess",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "ocr",
            "preprocess"
          ]
        },
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "image",
              "type": "file",
              "description": "Attach a .jpg file whose contents are actually garbage/text (rename a .txt to .jpg to simulate a corrupted upload).",
              "src": []
            },
            {
              "key": "language",
              "type": "text",
              "description": "",
              "value": "en"
            }
          ]
        },
        "description": "Content-type says image/jpeg but the bytes are not a real image -> OpenCV fails to decode -> 422."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 422', function () { pm.response.to.have.status(422); });",
              "pm.test('Error code is UNPROCESSABLE_ENTITY', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.error.code).to.eql('UNPROCESSABLE_ENTITY');",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    }
  ]
